---
import type { Direction } from '../data/directions';
import { statusLabels } from '../data/directions';

interface Props {
  direction: Direction;
  base: string;
}

const { direction, base } = Astro.props;
const href = `${base}/napravleniya/${direction.slug}`;
---

<a href={href} class="dcard" data-status={direction.status}>
  <div class="dcard__head">
    <span class="dcard__icon" aria-hidden="true">{direction.icon}</span>
    <span class="dcard__num mono">{String(direction.id).padStart(2, '0')}</span>
  </div>

  <h3 class="dcard__name">{direction.name}</h3>

  <p class="dcard__summary">{direction.summary}</p>

  <div class="dcard__foot">
    <span class="dcard__status">{statusLabels[direction.status]}</span>
    <span class="dcard__arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .dcard {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--gold-dim);
    background: var(--bg-raised);
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .dcard::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold), transparent);
    opacity: 0;
    transition: opacity 250ms;
  }

  .dcard:hover {
    border-color: var(--gold);
    background: var(--bg-subtle);
    transform: translateY(-2px);
  }

  .dcard:hover::before { opacity: 1; }

  .dcard[data-status='temporary']:hover {
    border-color: var(--cyan);
  }
  .dcard[data-status='temporary']::before {
    background: linear-gradient(to right, transparent, var(--cyan), transparent);
  }

  .dcard[data-status='transitional']:hover {
    border-color: var(--transitional);
  }
  .dcard[data-status='transitional']::before {
    background: linear-gradient(to right, transparent, var(--transitional), transparent);
  }

  .dcard__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dcard__icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .dcard__num {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--gold-dim);
  }

  .dcard__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 0;
    transition: color 200ms;
  }

  .dcard:hover .dcard__name { color: var(--gold-bright); }

  .dcard__summary {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .dcard__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--gold-dim);
    margin-top: auto;
  }

  .dcard__status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .dcard[data-status='temporary'] .dcard__status { color: var(--cyan); }
  .dcard[data-status='transitional'] .dcard__status { color: var(--transitional); }

  .dcard__arrow {
    color: var(--gold-dim);
    opacity: 0;
    transition: all 200ms;
  }

  .dcard:hover .dcard__arrow {
    color: var(--gold);
    opacity: 1;
    transform: translateX(4px);
  }
</style>