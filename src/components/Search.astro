---
// Компонент поиска на базе Pagefind
// Работает только на продакшене (после npm run build)
// В dev-режиме показывает заглушку
---

<button class="search-toggle" data-search-toggle aria-label="Поиск по Хартии">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-toggle__text mono">Поиск</span>
  <kbd class="search-toggle__kbd">⌘K</kbd>
</button>

<div class="search-modal" data-search-modal aria-hidden="true">
  <div class="search-modal__backdrop" data-search-close></div>
  <div class="search-modal__panel">
    <div class="search-modal__header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        class="search-modal__input"
        placeholder="Найти статью, принцип, термин…"
        data-search-input
        autocomplete="off"
      />
      <button class="search-modal__close" data-search-close aria-label="Закрыть">×</button>
    </div>
    <div class="search-modal__results" data-search-results></div>
    <div class="search-modal__hint" data-search-hint>
      Начните вводить запрос — например, «неизменяемое ядро» или «балансировка».
    </div>
  </div>
</div>

<script>
  const toggle = document.querySelector('[data-search-toggle]');
  const modal = document.querySelector('[data-search-modal]');
  const input = document.querySelector('[data-search-input]');
  const results = document.querySelector('[data-search-results]');
  const hint = document.querySelector('[data-search-hint]');
  const closeBtns = document.querySelectorAll('[data-search-close]');

  let pagefind: any = null;
  let pagefindLoading = false;

  function baseUrl(path: string): string {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    return `${base}${path.startsWith('/') ? path : `/${path}`}`;
  }

  // Обход Vite: new Function создаёт код вне его обработки,
  // поэтому import() здесь не будет преобразован в __VITE_PRELOAD__
  const dynamicImport = new Function('url', 'return import(url)') as
    (url: string) => Promise<any>;

  async function loadPagefind() {
    if (pagefind || pagefindLoading) return pagefind;
    pagefindLoading = true;

    const url = baseUrl('/pagefind/pagefind.js');

    try {
      console.log('[search] loading', url);
      const mod = await dynamicImport(url);

      // Отключаем встроенный Web Worker — с base=/hartia он часто падает
      await mod.options({ noWorker: true });
      await mod.init();

      console.log('[search] pagefind ready');
      pagefind = mod;
      pagefindLoading = false;
      return pagefind;
    } catch (e) {
      console.error('[search] failed', url, e);
      pagefindLoading = false;
      return null;
    }
  }

  function openModal() {
    modal?.classList.add('is-open');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 50);
    loadPagefind();
  }

  function closeModal() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openModal);
  closeBtns.forEach((b) => b.addEventListener('click', closeModal));

  document.addEventListener('keydown', (e) => {
    // Cmd+K / Ctrl+K
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      modal?.classList.contains('is-open') ? closeModal() : openModal();
    }
    // Esc
    if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
      closeModal();
    }
  });

  let debounceTimer: number | undefined;

  input?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    clearTimeout(debounceTimer);

    if (!query) {
      results!.innerHTML = '';
      hint!.style.display = '';
      return;
    }

    hint!.style.display = 'none';

    debounceTimer = window.setTimeout(async () => {
      const pf = await loadPagefind();
      if (!pf) {
        results!.innerHTML = `
          <div class="search-modal__empty">
            Поиск доступен только в собранной версии сайта.
            Запустите <code>npm run build</code> и <code>npm run preview</code>.
          </div>
        `;
        return;
      }

      const search = await pf.search(query);
      const topResults = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));

      if (topResults.length === 0) {
        results!.innerHTML = `<div class="search-modal__empty">Ничего не найдено по запросу «${query}».</div>`;
        return;
      }

      results!.innerHTML = topResults
        .map(
          (r: any) => `
          <a class="search-result" href="${r.url}">
            <div class="search-result__title">${r.meta?.title || r.url}</div>
            <div class="search-result__excerpt">${r.excerpt}</div>
            ${r.meta?.book ? `<div class="search-result__meta mono">${r.meta.book}</div>` : ''}
          </a>
        `
        )
        .join('');
    }, 180);
  });
</script>

<style>
  .search-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--gold-dim);
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: all var(--transition);
    border-radius: 2px;
    cursor: pointer;
  }

  .search-toggle:hover {
    color: var(--gold-bright);
    border-color: var(--gold);
  }

  .search-toggle__text {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .search-toggle__kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--gold-dim);
    color: var(--gold-dim);
    border-radius: 3px;
  }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
  }

  .search-modal.is-open { display: block; }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 9, 6, 0.85);
    backdrop-filter: blur(6px);
  }

  .search-modal__panel {
    position: relative;
    max-width: 680px;
    margin: 8vh auto 0;
    background: var(--bg-raised);
    border: 1px solid var(--gold-dim);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-modal__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--gold-dim);
    color: var(--text-muted);
  }

  .search-modal__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .search-modal__input::placeholder { color: var(--text-muted); }

  .search-modal__close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.75rem;
    cursor: pointer;
    line-height: 1;
    transition: color var(--transition);
  }

  .search-modal__close:hover { color: var(--gold-bright); }

  .search-modal__results {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-modal__hint,
  .search-modal__empty {
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
  }

  .search-result {
    display: block;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--gold-dim);
    transition: background var(--transition);
  }

  .search-result:last-child { border-bottom: none; }

  .search-result:hover { background: var(--bg-subtle); }

  .search-result__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--gold-bright);
    margin-bottom: 0.4rem;
  }

  .search-result__excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.4rem;
  }

  .search-result__excerpt mark {
    background: var(--gold-dim);
    color: var(--gold-bright);
    padding: 0 0.2rem;
  }

  .search-result__meta {
    font-size: 0.65rem;
    color: var(--gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .search-toggle__text,
    .search-toggle__kbd { display: none; }

    .search-modal__panel {
      margin: 0;
      max-height: 100vh;
      height: 100vh;
      border: none;
    }
  }
</style>